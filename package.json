{
  "name": "prun-credit-bureau",
  "version": "0.1.0",
  "private": true,
  "description": "Public, neutral credit bureau for Prosperous Universe lenders",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate": "wrangler d1 migrations apply bureau --local",
    "sheet:fetch": "tsx scripts/fetch-sheet.ts",
    "sheet:import": "tsx scripts/import-sheet.ts",
    "sheet:verify": "tsx scripts/verify-import.ts",
    "seed": "npm run db:migrate && npm run sheet:fetch && npm run sheet:import && npm run sheet:verify",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/normalize.test.ts",
    "db:reset": "node -e \"require('fs').rmSync('.wrangler/state',{recursive:true,force:true})\" && npm run db:migrate"
  },
  "dependencies": {
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "4.86.0"
  }
}
