{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prun-credit-bureau",
  "main": "src/index.tsx",
  "compatibility_date": "2026-04-01",
  "observability": { "enabled": true },
  // The site lives on its own subdomain only, so sign-in has a single address to return to.
  "routes": [{ "pattern": "bureau.prunbanking.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // Lets the Worker import the logo, the browser-side ledger script and the API description as strings.
  "rules": [{ "type": "Text", "globs": ["**/*.svg", "**/*.client.js", "**/*.yaml"], "fallthrough": true }],
  // FIO sync, hourly. To test locally: "npm run dev:cron", then open /__scheduled.
  "triggers": { "crons": ["0 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bureau",
      "database_id": "96bcc6bc-d51f-4816-a16d-f4651cf7df0f",
      "migrations_dir": "migrations"
    }
  ]
}
