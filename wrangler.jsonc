{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prun-credit-bureau",
  "main": "src/index.tsx",
  "compatibility_date": "2026-04-01",
  "observability": { "enabled": true },
  // Lets the Worker import assets/logo.svg as a string.
  "rules": [{ "type": "Text", "globs": ["**/*.svg"], "fallthrough": true }],
  // FIO sync, hourly. To test locally: "npm run dev:cron", then open /__scheduled.
  "triggers": { "crons": ["0 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bureau",
      // Placeholder: local dev ignores it. Replace with the real ID from `wrangler d1 create bureau` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
